# Copy to .env and fill in. Never commit the real .env.
# Docker Compose reads this file via env_file; on Coolify paste these into the
# app's "Environment Variables" tab instead. Restart / redeploy after any change.

# ---------------------------------------------------------------------------
# 1. Access — REQUIRED
# ---------------------------------------------------------------------------

# Your own password for the web UI. Choose anything long and random.
# The server refuses to start if this is empty.
APP_PASSWORD=change-me-to-a-long-random-password

# Recommended: key that signs login sessions. If unset it is derived from APP_PASSWORD.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 2. AI providers — the app shows a "Setup incomplete" banner and blocks
#    launching any feature whose keys are missing.
# ---------------------------------------------------------------------------

# SnapGen (formerly GeminiGen) — https://snapgen.ai
# REQUIRED for prompt packs: all video (Veo 3.1, Grok) and the primary image model.
SNAPGEN_API_KEY=

# OpenRouter — https://openrouter.ai/keys
# REQUIRED for Script Studio: the LLM that splits scripts into scenes and writes image prompts.
OPENROUTER_API_KEY=

# fal.ai — https://fal.ai/dashboard/keys
# REQUIRED for Script Studio narration (ElevenLabs TTS) unless KIE_API_KEY is set.
# Also Script Studio scene images and the last image fallback for prompt packs.
FAL_KEY=

# Kie.ai — https://kie.ai/api-key
# Recommended: image fallback for prompt packs, and backup narration (TTS) provider.
KIE_API_KEY=

# Default OpenRouter model for Script Studio (the UI lists every OpenRouter model).
DEFAULT_LLM_MODEL=anthropic/claude-sonnet-5

# ---------------------------------------------------------------------------
# 3. Optional: NextCloud — upload finished videos and return a public share link.
#    Leave empty to keep finished videos on the server (playable/downloadable in the UI).
# ---------------------------------------------------------------------------

# WebDAV base, e.g. https://cloud.example.com/remote.php/dav/files/<username>
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
# Use a NextCloud app password, not your login password.
NEXTCLOUD_PASSWORD=
NEXTCLOUD_ROOT=/AI_Video_Production_Hub

# ---------------------------------------------------------------------------
# 4. Optional: NocoDB — mirror runs, images and videos into tables.
#    Sync is enabled only when all three are set.
# ---------------------------------------------------------------------------

NOCODB_URL=
NOCODB_API_TOKEN=
NOCODB_BASE_ID=

# ---------------------------------------------------------------------------
# 5. Advanced
# ---------------------------------------------------------------------------

# Where the database, uploads and renders live. The Docker image sets /app/data —
# don't set this on Docker/Coolify. For local development: ./data
DATA_DIR=./data

# Comma-separated origins allowed to call the API from another domain.
# Leave empty when the UI and API are served together (the default Docker setup).
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Optional tooling only (execution/ scripts, not the app)
# ---------------------------------------------------------------------------
APIFY_API_TOKEN=
GOOGLE_AI_STUDIO_API_KEY=
